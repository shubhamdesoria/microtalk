# git folder
.git
.gitignore

# npm
node_modules
npm-debug.log

# mac
.DS_Store

# cache
.cache

# Environment files and generated local configuration must never enter an image.
.env*
app/src/config.js

# TLS terminates at the Kubernetes ingress in production. Direct-TLS users can
# mount certificates at TLS_KEY_PATH and TLS_CERT_PATH instead.
app/ssl/*.pem
